APP_MODE=saas

# =============================================================================
# Database (required)
# =============================================================================
DATABASE_HOST=localhost
DATABASE_NAME=
DATABASE_USER=

DATABASE_PASSWORD=
ADMIN_PASSWORD=

# =============================================================================
# Public URL (required)
# =============================================================================
NEXT_PUBLIC_APP_URL=https://biyabaman.ir

# =============================================================================
# Telegram Login Widget (required for /login /signup)
# =============================================================================
# TELEGRAM_BOT_TOKEN — BotFather HTTP API token (server only; never NEXT_PUBLIC_)
# TELEGRAM_BOT_USERNAME — bot username without @ (widget data-telegram-login)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# =============================================================================
# Email — optional (not used for Telegram auth)
# =============================================================================
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=

# Payments
# ZARINPAL_MERCHANT_ID=
# ZARINPAL_SANDBOX=true

# Runtime (usually set by cPanel / Passenger — do not change unless needed)
# NODE_ENV=
# PORT=
# HOSTNAME=
